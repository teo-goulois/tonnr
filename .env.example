# Read by docker-compose.yml. Copy to .env to change a value. The API's own settings are in
# apps/server/.env.example.

# The password of the database's `postgres` user, from letters and digits only: it goes into the
# database's address as it is. Postgres takes it when it first creates its volume: changing it
# later does not change the password of an existing database.
POSTGRES_PASSWORD=password
# Where the API and Postgres listen on this machine.
# API_PORT=3000
# POSTGRES_PORT=5432
