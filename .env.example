# Read by docker-compose.yml, by the deploy commands and by the releases of the app for phones.
# Copy to .env to change a value. The API's own settings are in apps/server/.env.example.

# The password of the database's `postgres` user, from letters and digits only: it goes into the
# database's address as it is. Postgres takes it when it first creates its volume: changing it
# later does not change the password of an existing database.
POSTGRES_PASSWORD=password

# The key of an account on Météo-France's API portal, which the worker sends to fetch the wind of
# Météo-France's stations. Without it the worker leaves them out. docs/self-hosting.md says how
# to get one.
# METEO_FRANCE_API_KEY=your_key

# The key of an account on AEMET OpenData, which the worker sends to fetch the wind of Spain's
# stations. Without it the worker leaves them out. docs/self-hosting.md says how to get one.
# AEMET_API_KEY=your_key

# Where the API and Postgres listen on this machine.
# API_PORT=3000
# POSTGRES_PORT=5432

# The address Easypanel gives a service to deploy it, under "Deployments". Whoever knows it can
# deploy the service. `pnpm run deploy:api` and `pnpm run deploy:worker` call them.
# EASYPANEL_API_DEPLOY_URL=http://203.0.113.10:3000/api/deploy/0123456789abcdef
# EASYPANEL_WORKER_DEPLOY_URL=http://203.0.113.10:3000/api/deploy/fedcba9876543210

# The address of the deployed API, such as https://api.example.org. The two commands read its
# health there, at `/v1/health`, to wait until what they deployed has started, and
# `pnpm run deploy:status` says since when the API and the worker run. It is no secret.
# DEPLOYED_API_URL=https://api.example.org

# What the releases of the app for phones write the bucket of its updates with, from this machine
# alone: `pnpm run release:js <stage>` its publications, and `pnpm run release:ios <stage>` and
# `pnpm run release:android <stage>` the runtime of each store build. Decision 075. An R2 token
# of the Cloudflare account, with "Object Read & Write" on that bucket and no other, as its two S3
# credentials. The account's id is the one of packages/infra/.env.
# UPDATES_R2_ACCESS_KEY_ID=0123456789abcdef0123456789abcdef
# UPDATES_R2_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Where the key that signs the updates lies, outside the repository, which
# `npx expo-updates codesigning:generate` made with apps/native/certs/certificate.pem. Keep a copy
# in a password manager: without it, the binaries that carry the certificate take no update.
# UPDATES_SIGNING_KEY=~/.config/tonnr/updates/private-key.pem

# What `pnpm run release:ios <stage>` signs and uploads with: a key of App Store Connect, with its
# id, the issuer of the team's keys, and its file, which keeps the name Apple gives it,
# AuthKey_<id>.p8, since altool finds it by it. xcodebuild makes or fetches the certificates and
# profiles with it. Apple lets the file be downloaded once: keep a copy in a password manager.
# APP_STORE_CONNECT_KEY_ID=A1B2C3D4E5
# APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000
# APP_STORE_CONNECT_KEY=~/.config/tonnr/apple/AuthKey_A1B2C3D4E5.p8

# What `pnpm run release:android <stage>` signs and uploads with: the upload key, a keystore made
# with keytool, which only proves that a build is yours, with its alias and its passwords, which
# Gradle reads from a file of its own, outside the checkout and deleted once it is done, and which
# its environment, inherited by the tools of the build, never holds; and the JSON key of the
# Google Cloud service account that the Play Console invited with the right to release.
# And Firebase's google-services.json of the Android app, which it registers for push with, read
# by `pnpm run release:android <stage>` and by `pnpm run release:js <stage>` alike, since the
# fingerprint of the app's runtime hashes it. Decision 072.
# GOOGLE_SERVICES_FILE=~/.config/tonnr/android/google-services.json
# ANDROID_UPLOAD_KEYSTORE=~/.config/tonnr/android/upload.jks
# ANDROID_UPLOAD_KEYSTORE_PASSWORD=your_password
# ANDROID_UPLOAD_KEY_ALIAS=upload
# ANDROID_UPLOAD_KEY_PASSWORD=your_password
# GOOGLE_PLAY_SERVICE_ACCOUNT=~/.config/tonnr/android/play-service-account.json

# The licence key of the Nucleo icons, which their packages check when pnpm installs them. pnpm
# does not read this file, so hand the key to an install:
# `export $(grep NUCLEO_LICENSE_KEY .env) && pnpm install`.
# NUCLEO_LICENSE_KEY=0123456789abcdef0123456789abcd

# À classer

EASYPANEL_API_DEPLOY_URL=
EASYPANEL_WORKER_DEPLOY_URL=
NUCLEO_LICENSE_KEY=
