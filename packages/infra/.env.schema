# @import(../../apps/web/, pick=[NODE_ENV, VITE_SERVER_URL, VITE_POSTHOG_PROJECT_TOKEN, VITE_POSTHOG_HOST, VITE_POSTHOG_ENVIRONMENT, VITE_UMAMI_SCRIPT_URL, VITE_UMAMI_WEBSITE_ID, VITE_APP_STORE_ID])
# @defaultRequired=false
# @defaultSensitive=true
# ---

# What a deployment to Cloudflare reads: decision 021. `pnpm run deploy:web <stage>` takes the
# two accesses from .env, and the stage's values from .env.<stage>, VITE_SERVER_URL among them.
# Development reads none of the four.

# An API token of the Cloudflare account. docs/self-hosting.md lists what it may do.
CLOUDFLARE_API_TOKEN=

# @public
CLOUDFLARE_ACCOUNT_ID=

# The host name of the stage's web app, on the same site as its API.
# @public
WEB_DOMAIN=

# "true" lets search engines list the stage.
# @public @type=boolean
WEB_INDEXED=

# The host name of the stage's admin app, when it has one: on the same site as its API, and
# not the web app's. Decision 020.
# @public
ADMIN_DOMAIN=

# The host name of the Worker that serves the updates of the app for phones, which every binary
# built for the stage asks for good, and the host name of the bucket that serves their files. A
# stage that names both has them. Decision 075.
# @public
UPDATES_DOMAIN=
# @public
UPDATES_FILES_DOMAIN=

# The team of the Apple developer account that signs the app for iPhones, when the stage's links
# open it: ten capitals and digits. Every copy of the app carries it. Decision 073.
# @public
APPLE_TEAM_ID=

# The SHA-256 fingerprints of the keys that sign the app for Android, separated by commas: the
# keys of Play App Signing, three for a new app, and the upload key. Every copy of the app carries them. Decision 073.
# @public
ANDROID_CERT_SHA256=
