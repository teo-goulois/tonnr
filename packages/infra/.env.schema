# @import(../../apps/web/, pick=[NODE_ENV, VITE_SERVER_URL, VITE_POSTHOG_PROJECT_TOKEN, VITE_POSTHOG_HOST, VITE_POSTHOG_ENVIRONMENT, VITE_UMAMI_SCRIPT_URL, VITE_UMAMI_WEBSITE_ID])
# @defaultRequired=false
# @defaultSensitive=true
# ---

# What a deployment to Cloudflare reads: decision 021. `pnpm run deploy:web <stage>` takes the
# two accesses from .env, and the stage's values from .env.<stage>, VITE_SERVER_URL among them.
# Development reads none of the four.

# An API token of the Cloudflare account. docs/self-hosting.md lists what it may do.
CLOUDFLARE_API_TOKEN=

# @public
CLOUDFLARE_ACCOUNT_ID=

# The host name of the stage's web app, on the same site as its API.
# @public
WEB_DOMAIN=

# "true" lets search engines list the stage.
# @public @type=boolean
WEB_INDEXED=

# The host name of the stage's admin app, when it has one: on the same site as its API, and
# not the web app's. Decision 020.
# @public
ADMIN_DOMAIN=
