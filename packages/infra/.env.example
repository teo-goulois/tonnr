# What `pnpm run deploy:web <stage>`, `pnpm run deploy:admin <stage>` and
# `pnpm run deploy:updates <stage>` read, in two files next to this one. The releases of the app
# for phones read the stage's file too, and the account's id. The schema in .env.schema describes each variable, and docs/self-hosting.md gives the
# steps.

# In .env: the access to the Cloudflare account, the same for every stage. The token is a
# secret: whoever has it can change the account's Workers.
CLOUDFLARE_API_TOKEN=0123456789abcdefghijklmnopqrstuvwxyzABCD
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef

# In .env.<stage>, such as .env.dev: what tells one stage from another. Leave these four out
# of .env.
# The host name of the web app, in a zone of the Cloudflare account and on the same site as the
# API.
# WEB_DOMAIN=dev.example.org
# The public address of the API this stage talks to.
# VITE_SERVER_URL=https://api.example.org
# Optional. "true" lets search engines list this stage. Without it, the web app tells them not
# to.
# WEB_INDEXED=false
# Optional. Other host names of the web app, separated by commas, such as www. before its
# domain: each sends every request on to the same page at WEB_DOMAIN.
# WEB_REDIRECTS=www.example.org
# Optional. The host name of the stage's admin app, on the same site as the API and not the web
# app's. The API names it in its ADMIN_ORIGIN. Without it, the stage has no admin app.
# ADMIN_DOMAIN=admin.example.org

# Optional, in .env.<stage>, set together: the updates of the app for phones, which
# `pnpm run deploy:updates <stage>` deploys. Every binary built for the stage asks the first for
# good. Decision 075.
# The host name of the Worker that answers the apps.
# UPDATES_DOMAIN=updates.example.org
# The host name of the bucket that serves the files of an update.
# UPDATES_FILES_DOMAIN=bundles.example.org

# Optional, in .env.<stage>: the apps for phones that open the stage's links, which the web app
# names at /.well-known/. Without them, it claims no app. Decision 073.
# The team of the Apple developer account that signs the app for iPhones.
# APPLE_TEAM_ID=A1B2C3D4E5
# The SHA-256 fingerprints of the keys that sign the app for Android, separated by commas: Play
# App Signing's, three for a new app, then the upload key's.
# ANDROID_CERT_SHA256=14:6D:E9:83:C5:73:06:50:D8:EE:B9:95:2F:34:FC:64:16:A0:83:42:E6:1D:BE:A8:8A:04:96:B2:3F:CF:44:E5,FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C
# The id of the app for iPhones in the App Store, once it is there: the pages a link is sent to
# then show Safari's banner, which offers the app.
# VITE_APP_STORE_ID=1234567890

# Optional product analytics, in .env.<stage>. Use the same project and environment as the API.
# VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_POSTHOG_ENVIRONMENT=dev

# Optional audience counts by Umami, in .env.<stage>, set together. Decision 055.
# VITE_UMAMI_SCRIPT_URL=https://umami.example.org/script.js
# VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# À classer

WEB_DOMAIN=
VITE_SERVER_URL=
ADMIN_DOMAIN=
WEB_INDEXED=
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
VITE_POSTHOG_ENVIRONMENT=
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
WEB_REDIRECTS=
