# What `pnpm run deploy:web <stage>` and `pnpm run deploy:admin <stage>` read, in two files next to
# this one. The schema in .env.schema describes each variable, and docs/self-hosting.md gives the
# steps.

# In .env: the access to the Cloudflare account, the same for every stage. The token is a
# secret: whoever has it can change the account's Workers.
CLOUDFLARE_API_TOKEN=0123456789abcdefghijklmnopqrstuvwxyzABCD
CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef

# In .env.<stage>, such as .env.dev: what tells one stage from another. Leave these four out
# of .env.
# The host name of the web app, in a zone of the Cloudflare account and on the same site as the
# API.
# WEB_DOMAIN=dev.example.org
# The public address of the API this stage talks to.
# VITE_SERVER_URL=https://api.example.org
# Optional. "true" lets search engines list this stage. Without it, the web app tells them not
# to.
# WEB_INDEXED=false
# Optional. The host name of the stage's admin app, on the same site as the API and not the web
# app's. The API names it in its ADMIN_ORIGIN. Without it, the stage has no admin app.
# ADMIN_DOMAIN=admin.example.org
