{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["apps/native/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@repo/api",
                  "@repo/api/**",
                  "@repo/db",
                  "@repo/db/**",
                  "@repo/auth",
                  "@repo/auth/**",
                  "@repo/media",
                  "@repo/media/**",
                  "@repo/push",
                  "@repo/push/**",
                  "@repo/mail",
                  "@repo/mail/**",
                  "@repo/upstream",
                  "@repo/upstream/**",
                  "@repo/infra",
                  "@repo/infra/**"
                ],
                "allowTypeImports": true,
                "message": "The app imports the server's packages as types only: what runs there needs Node and the database (decision 069)."
              },
              {
                "group": [
                  "@repo/conditions/tides/*",
                  "@repo/conditions/spots/conditions",
                  "@repo/conditions/forecasts/forecasts",
                  "@repo/conditions/forecasts/open-meteo",
                  "@repo/conditions/forecasts/open-data",
                  "@repo/conditions/forecasts/copernicus-*",
                  "@repo/conditions/forecasts/cell-forecast",
                  "@repo/conditions/forecasts/model-files",
                  "@repo/conditions/forecasts/testing"
                ],
                "allowTypeImports": true,
                "message": "This module of packages/conditions reads files or asks a provider: the app asks the API instead (decision 069)."
              }
            ],
            "paths": [
              {
                "name": "@tanstack/react-form",
                "allowTypeImports": true,
                "message": "A form of the app is made with useAppForm, from @/components/ui/form, and its fields with its adapters (decision 078)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/native/src/components/ui/form.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@repo/api",
                  "@repo/api/**",
                  "@repo/db",
                  "@repo/db/**",
                  "@repo/auth",
                  "@repo/auth/**",
                  "@repo/media",
                  "@repo/media/**",
                  "@repo/push",
                  "@repo/push/**",
                  "@repo/mail",
                  "@repo/mail/**",
                  "@repo/upstream",
                  "@repo/upstream/**",
                  "@repo/infra",
                  "@repo/infra/**"
                ],
                "allowTypeImports": true,
                "message": "The app imports the server's packages as types only: what runs there needs Node and the database (decision 069)."
              },
              {
                "group": [
                  "@repo/conditions/tides/*",
                  "@repo/conditions/spots/conditions",
                  "@repo/conditions/forecasts/forecasts",
                  "@repo/conditions/forecasts/open-meteo",
                  "@repo/conditions/forecasts/open-data",
                  "@repo/conditions/forecasts/copernicus-*",
                  "@repo/conditions/forecasts/cell-forecast",
                  "@repo/conditions/forecasts/model-files",
                  "@repo/conditions/forecasts/testing"
                ],
                "allowTypeImports": true,
                "message": "This module of packages/conditions reads files or asks a provider: the app asks the API instead (decision 069)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/client/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**",
                  "react-native",
                  "react-native/**",
                  "expo",
                  "expo/**",
                  "expo-*",
                  "expo-*/**",
                  "@expo/**",
                  "node:*",
                  "**/apps/**"
                ],
                "message": "packages/client holds rules both apps run, on a page and on a phone: what reads React, the DOM, a phone, Node or an app's own files stays in that app (decision 069)."
              },
              {
                "group": [
                  "@repo/api",
                  "@repo/api/**",
                  "@repo/db",
                  "@repo/db/**",
                  "@repo/auth",
                  "@repo/auth/**",
                  "@repo/media",
                  "@repo/media/**",
                  "@repo/push",
                  "@repo/push/**",
                  "@repo/mail",
                  "@repo/mail/**",
                  "@repo/upstream",
                  "@repo/upstream/**",
                  "@repo/infra",
                  "@repo/infra/**",
                  "@repo/ui",
                  "@repo/ui/**"
                ],
                "allowTypeImports": true,
                "message": "packages/client imports the server's packages and the interface as types only: both apps run it (decision 069)."
              },
              {
                "group": [
                  "@repo/conditions/tides/*",
                  "@repo/conditions/spots/conditions",
                  "@repo/conditions/forecasts/forecasts",
                  "@repo/conditions/forecasts/open-meteo",
                  "@repo/conditions/forecasts/open-data",
                  "@repo/conditions/forecasts/copernicus-*",
                  "@repo/conditions/forecasts/cell-forecast",
                  "@repo/conditions/forecasts/model-files",
                  "@repo/conditions/forecasts/testing"
                ],
                "allowTypeImports": true,
                "message": "This module of packages/conditions reads files or asks a provider: the apps ask the API instead (decision 069)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**", "apps/admin/src/**"],
      "plugins": ["react"],
      "rules": {
        "react/forbid-elements": [
          "error",
          {
            "forbid": [
              {
                "element": "form",
                "message": "A form is made with useAppForm and sent through form.Form, from @repo/ui/hooks/form/form (decision 076)."
              }
            ]
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-form",
                "allowTypeImports": true,
                "message": "A form is made with useAppForm, from @repo/ui/hooks/form/form, and its fields with its adapters (decision 076)."
              }
            ]
          }
        ],
        "react/refs": "off",
        "react/set-state-in-effect": "off",
        "react/jsx-key": "off",
        "react/purity": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    }
  ]
}
