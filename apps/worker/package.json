{
  "name": "worker",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "ingest": "tsx src/cli.ts",
    "test": "vitest run",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/upstream": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg-boss": "^12.37.0",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  }
}
