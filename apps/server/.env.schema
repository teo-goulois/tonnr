# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=number
PORT=3000

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# Optional Google sign-in. Set both credentials, or leave both empty.
# @public @optional @type=string
GOOGLE_CLIENT_ID=

# @optional @type=string
GOOGLE_CLIENT_SECRET=

# Optional. The client of Google's own sign-in sheet in the app for iPhone: the API then also
# takes an ID token made for it. It needs the two above. Android's sheet makes its tokens for the
# web's client, which the API takes already. Decision 070.
# @public @optional @type=string
GOOGLE_IOS_CLIENT_ID=

# Optional Sign in with Apple, on the web and in the app for iPhone. Set the Services ID, the
# key's id and the key's content together, with the team, or none of the three: some and not all
# stop the API as it starts. docs/self-hosting.md, "Signing in with Apple". Decision 070.
# The Services ID that names the web's sign-in at Apple, such as `app.example.web`.
# @public @optional @type=string
APPLE_SERVICES_ID=

# The team of the Apple developer account: ten letters and figures. The pushes to the iOS app
# are signed for it too, with the key of APNS_KEY_ID: decision 072.
# @public @optional @type=string(matches=/^[A-Z0-9]{10}$/)
APPLE_TEAM_ID=

# The id of the key that has Sign in with Apple: ten letters and figures.
# @public @optional @type=string(matches=/^[A-Z0-9]{10}$/)
APPLE_KEY_ID=

# The content of the key's .p8 file, from `-----BEGIN PRIVATE KEY-----` to its end, its lines
# kept or written `\n` on one line.
# @optional @type=string(minLength=1)
APPLE_PRIVATE_KEY=

# @public @type=url
CORS_ORIGIN=

# The address of the admin app, when the instance has one. It must not be the web app's.
# @public @optional @type=url
ADMIN_ORIGIN=

# The origins the instance's apps for phones name themselves by, separated by commas, such as
# `app.example://`. Without it, the one of the apps this repository builds, `app.tonnr://`.
# Decision 069.
# @public @optional @type=string
APP_ORIGINS=

# Which builds of the apps for phones the instance answers, for each platform: the oldest it
# still answers, the newest its store sells, and the app's page in that store. A build is the
# number an app sends after its version in `X-App`, the count of the commits of `main` up to the
# one built. Each is optional: without the oldest every build is answered, and an app older than
# it asks to be updated. `GET /v1/clients` answers them to anyone. Decision 069.
# @public @optional @type=number(min=1, isInt=true)
APP_IOS_OLDEST_BUILD=
# @public @optional @type=number(min=1, isInt=true)
APP_IOS_NEWEST_BUILD=
# @public @optional @type=url
APP_IOS_STORE_URL=
# @public @optional @type=number(min=1, isInt=true)
APP_ANDROID_OLDEST_BUILD=
# @public @optional @type=number(min=1, isInt=true)
APP_ANDROID_NEWEST_BUILD=
# @public @optional @type=url
APP_ANDROID_STORE_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Optional private research catalogue, read only from the admin. Never give this URL to an
# app's build or browser. It is separate from DATABASE_URL and receives no app migrations.
# @optional @type=string(minLength=1)
CATALOGUE_DATABASE_URL=

# The mail the instance sends, to check an account's address. Set one of the two ways out, or
# neither: without one the instance sends no mail and checks no address. Decision 026.
# @optional @type=string(minLength=1)
UNOSEND_API_KEY=

# `smtp://user:password@host:587`, or `smtps://` for a server that speaks TLS from the start.
# @optional @type=string(minLength=1)
SMTP_URL=

# Who the mail is from: `Name <address>`, or an address alone. Needed with a way out.
# @public @optional @type=string(minLength=3)
EMAIL_FROM=

# How many mails the instance lets out in a day. 200 without it.
# @public @optional @type=number
EMAIL_DAILY_LIMIT=

# The pair of keys an instance sends push with: both, or neither. `pnpm --filter worker run job
# push-keys` makes one. Decision 031, "Push".
# The API gives the public one to the web app, where a browser subscribes with it: a point of
# the curve P-256 as its 65 bytes, in base64url with no padding. Without it the API takes no
# subscription, and the web app says that the instance sends no notification.
# @public @optional @type=string(matches=/^B[A-Za-z0-9_-]{85}[AEIMQUYcgkosw048]$/)
VAPID_PUBLIC_KEY=

# The private one is for the worker, which signs what it sends: 32 bytes, in base64url with no
# padding. The API never reads it.
# @optional @type=string(matches=/^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$/)
VAPID_PRIVATE_KEY=

# Push to the instance's apps for phones, through Apple's and Google's services: decision 072,
# and docs/self-hosting.md, "Alerts by push". Each app is optional, and an app the instance
# holds nothing of is pushed to by no one. A worker that holds some of an app's variables and
# not all of them does not start, and names what is missing. The iOS app's are the three APNS_*
# with the team of the Apple developer account that signs the app, APPLE_TEAM_ID, which Sign in
# with Apple reads too.

# The id of the team's key for APNs, and the key itself, the text of the `.p8` file Apple gives,
# whose line breaks may be written `\n`. The worker signs with it. One key serves both of
# Apple's hosts and every app of the team.
# @public @optional @type=string(matches=/^[A-Z0-9]{10}$/)
APNS_KEY_ID=
# @optional @type=string(startsWith="-----BEGIN PRIVATE KEY-----")
APNS_PRIVATE_KEY=

# The bundle the iOS app is built with, which its pushes go under: `app.tonnr` for the apps this
# repository builds. The API takes an iPhone's device only with it, and only of that app.
# @public @optional @type=string(matches=/^[A-Za-z0-9][A-Za-z0-9.-]*[.][A-Za-z0-9-]+$/)
APNS_TOPIC=

# The Firebase project the Android app is built with. The API takes an Android phone's device
# only with it.
# @public @optional @type=string(matches=/^[a-z][a-z0-9-]{4,28}[a-z0-9]$/)
FCM_PROJECT_ID=

# The project's service account the worker sends with, which is given FCM's role and no other,
# and its private key, as `private_key` in the account's JSON file: the text of a PEM file,
# whose line breaks may be written `\n`.
# @public @optional @type=email
FCM_CLIENT_EMAIL=
# @optional @type=string(startsWith="-----BEGIN PRIVATE KEY-----")
FCM_PRIVATE_KEY=

# The search service that finds a place by its name: the address of a Photon. Without it the
# instance asks Photon's public service, which promises nothing. Decision 030.
# @public @optional @type=url
PLACES_URL=

# The bucket the photos and the videos are kept in: a bucket of Cloudflare R2, and an API token
# of R2 that reads and writes it. All four, or none: without them the instance keeps no photo
# and no video, and the web app offers none. The worker reads them too. Decision 066, and
# docs/self-hosting.md, "Photos and videos".
# @public @optional @type=string(minLength=3)
MEDIA_BUCKET=
# @public @optional @type=string(minLength=1)
R2_ACCOUNT_ID=
# The token's id is a part of every address the bucket signs, which the API answers: it is no
# secret. Its secret is.
# @public @optional @type=string(minLength=1)
R2_ACCESS_KEY_ID=
# @optional @type=string(minLength=1)
R2_SECRET_ACCESS_KEY=
# Another address than R2's for the same API, such as a store run on this machine for
# development: R2_ACCOUNT_ID is then not read.
# @public @optional @type=url
MEDIA_ENDPOINT=
# Where the worker finds the two models it analyses the photos of a report with. Its image holds
# them in `models`, beside its program, which is where it looks without this: `pnpm --filter
# worker exec tsx scripts/fetch-models.ts` puts them there. Decision 067.
# @public @optional @type=string(minLength=1)
MEDIA_MODELS_DIR=
# How many days the worker keeps a report before it deletes it with its photos and videos.
# Without it every report is kept, hidden from everyone once it is a week old. Decision 067.
# @public @optional @type=number(min=1, isInt=true)
REPORT_KEEP_DAYS=
# The key of an account on Météo-France's API portal, which the worker sends to fetch the wind
# of its stations. Without it the worker leaves them out. Decision 032.
# @optional @type=string(minLength=1)
METEO_FRANCE_API_KEY=

# The key of an account on AEMET OpenData, Spain's weather agency, which the worker sends to
# fetch the wind of its stations. Without it the worker leaves them out. Decision 048.
# @optional @type=string(minLength=1)
AEMET_API_KEY=

# Optional product analytics. All three are set together, or none. Decision 044.
# @public @optional @type=string(minLength=1)
POSTHOG_PROJECT_TOKEN=

# EU: https://eu.i.posthog.com; US: https://us.i.posthog.com
# @public @optional @type=enum(https://eu.i.posthog.com, https://us.i.posthog.com)
POSTHOG_HOST=

# Separates local use, pre-production and production in the project's reports.
# @public @optional @type=enum(development, dev, production)
POSTHOG_ENVIRONMENT=
