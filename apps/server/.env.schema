# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=number
PORT=3000

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# Optional Google sign-in. Set both credentials, or leave both empty.
# @optional @type=string
GOOGLE_CLIENT_ID=

# @optional @type=string
GOOGLE_CLIENT_SECRET=

# @public @type=url
CORS_ORIGIN=

# The address of the admin app, when the instance has one. It must not be the web app's.
# @public @optional @type=url
ADMIN_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# The mail the instance sends, to check an account's address. Set one of the two ways out, or
# neither: without one the instance sends no mail and checks no address. Decision 026.
# @optional @type=string(minLength=1)
UNOSEND_API_KEY=

# `smtp://user:password@host:587`, or `smtps://` for a server that speaks TLS from the start.
# @optional @type=string(minLength=1)
SMTP_URL=

# Who the mail is from: `Name <address>`, or an address alone. Needed with a way out.
# @public @optional @type=string(minLength=3)
EMAIL_FROM=

# How many mails the instance lets out in a day. 200 without it.
# @public @optional @type=number
EMAIL_DAILY_LIMIT=

# The pair of keys an instance sends push with: both, or neither. `pnpm --filter worker run job
# push-keys` makes one. Decision 031, "Push".
# The API gives the public one to the web app, where a browser subscribes with it: a point of
# the curve P-256 as its 65 bytes, in base64url with no padding. Without it the API takes no
# subscription, and the web app says that the instance sends no notification.
# @public @optional @type=string(matches=/^B[A-Za-z0-9_-]{85}[AEIMQUYcgkosw048]$/)
VAPID_PUBLIC_KEY=

# The private one is for the worker, which signs what it sends: 32 bytes, in base64url with no
# padding. The API never reads it.
# @optional @type=string(matches=/^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$/)
VAPID_PRIVATE_KEY=

# The search service that finds a place by its name: the address of a Photon. Without it the
# instance asks Photon's public service, which promises nothing. Decision 030.
# @public @optional @type=url
PLACES_URL=

# The key of an account on Météo-France's API portal, which the worker sends to fetch the wind
# of its stations. Without it the worker leaves them out. Decision 032.
# @optional @type=string(minLength=1)
METEO_FRANCE_API_KEY=

# Optional product analytics. All three are set together, or none. Decision 044.
# @public @optional @type=string(minLength=1)
POSTHOG_PROJECT_TOKEN=

# EU: https://eu.i.posthog.com; US: https://us.i.posthog.com
# @public @optional @type=enum(https://eu.i.posthog.com, https://us.i.posthog.com)
POSTHOG_HOST=

# Separates local use, pre-production and production in the project's reports.
# @public @optional @type=enum(development, dev, production)
POSTHOG_ENVIRONMENT=
