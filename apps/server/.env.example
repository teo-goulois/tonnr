# Copy to .env and fill in. The schema in .env.schema describes each variable.

# At least 32 random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional Google sign-in. Set both, or neither. See docs/self-hosting.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public address of this API.
BETTER_AUTH_URL=http://localhost:3000
# The address of the web app, allowed to call this API from a browser.
CORS_ORIGIN=http://localhost:3001
# Optional. The address of the admin app, which alone may then run the instance from a browser.
# It must not be the web app's. Without it, the operator runs the instance with scripts.
# ADMIN_ORIGIN=http://localhost:3002
DATABASE_URL=postgresql://postgres:password@localhost:5432/app
# Optional. A separate private catalogue for the admin's Sources tab. Server runtime only.
# CATALOGUE_DATABASE_URL=postgresql://catalogue_reader:password@localhost:5433/research
# Optional. The API listens on 3000 when it is not set.
# PORT=3000
# Optional. The mail that checks an account's address. Set one way out, with a sender, or
# neither: without one the instance sends no mail and checks no address.
# UNOSEND_API_KEY=un_your_key
# SMTP_URL=smtp://user:password@mail.example.org:587
# EMAIL_FROM=Tonnr <hello@example.org>
# How many mails the instance lets out in a day. 200 when it is not set.
# EMAIL_DAILY_LIMIT=200
# Optional. The pair of keys the instance sends push with: both, or neither. Make one with
# `pnpm --filter worker run job push-keys`. Without them the instance sends no push.
# VAPID_PUBLIC_KEY=the_public_key_of_the_pair
# VAPID_PRIVATE_KEY=the_private_key_of_the_pair
# Optional. The Photon that finds a place by its name. Photon's public service when it is not set.
# PLACES_URL=http://photon:2322
# Optional. The key of an account on Météo-France's API portal, which the worker sends to fetch
# the wind of Météo-France's stations. Without it the worker leaves them out.
# METEO_FRANCE_API_KEY=your_key
# Optional. The key of an account on AEMET OpenData, which the worker sends to fetch the wind of
# Spain's stations. Without it the worker leaves them out.
# AEMET_API_KEY=your_key

# Optional. Your own PostHog project, region and environment, all three together.
# POSTHOG_PROJECT_TOKEN=phc_your_project_token
# POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_ENVIRONMENT=development
