# Copy to .env and fill in. The schema in .env.schema describes each variable.

# At least 32 random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public address of this API.
BETTER_AUTH_URL=http://localhost:3000
# The address of the web app, allowed to call this API from a browser.
CORS_ORIGIN=http://localhost:3001
# Optional. The address of the admin app, which alone may then run the instance from a browser.
# It must not be the web app's. Without it, the operator runs the instance with scripts.
# ADMIN_ORIGIN=http://localhost:3002
DATABASE_URL=postgresql://postgres:password@localhost:5432/app
# Optional. The API listens on 3000 when it is not set.
# PORT=3000
# Optional. The mail that checks an account's address. Set one way out, with a sender, or
# neither: without one the instance sends no mail and checks no address.
# UNOSEND_API_KEY=un_your_key
# SMTP_URL=smtp://user:password@mail.example.org:587
# EMAIL_FROM=Tonnr <hello@example.org>
# How many mails the instance lets out in a day. 200 when it is not set.
# EMAIL_DAILY_LIMIT=200
