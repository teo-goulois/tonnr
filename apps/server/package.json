{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "@hono/node-server": "^2.1.1",
    "@neaps/tide-database": "catalog:",
    "@opencoredev/email-sdk": "2.0.0",
    "@openmeteo/file-format-wasm": "0.0.20",
    "@openmeteo/file-reader": "0.0.20",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@repo/api": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/mail": "workspace:*",
    "@repo/media": "workspace:*",
    "better-auth": "catalog:",
    "files-sdk": "^3.1.1",
    "hono": "^4.13.7",
    "nodemailer": "10.0.16",
    "posthog-node": "^5.55.2",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  }
}
