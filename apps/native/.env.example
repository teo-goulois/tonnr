# The API the app calls. On the iPhone simulator, the API on this Mac; on an Android emulator,
# 10.0.2.2 is the Mac. A phone needs an address it reaches, such as a tunnel's.
EXPO_PUBLIC_SERVER_URL=http://localhost:3000
# The web app's address, which the app's shared links name.
EXPO_PUBLIC_SITE_URL=http://localhost:3001
# The project of PostHog the app sends its analytics and its error reports to, once the person
# said yes, through the web app's /ingest at EXPO_PUBLIC_SITE_URL, and the environment its events
# say. Leave them out and the app sends nothing and asks nothing. The release commands give the
# stage's to the store's builds.
# EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# EXPO_PUBLIC_POSTHOG_ENVIRONMENT=development
# The address the app asks for updates of its JavaScript. Leave it out of a development build,
# which then asks for none: the release commands give it to the store's builds.
# UPDATES_URL=https://updates.example.org
# The build number of a store build, which the release commands give. Leave it out of a
# development build, which is build 1.
# APP_BUILD_NUMBER=418
# The Apple team that signs the app, which the release commands give an iOS build.
# APPLE_TEAM_ID=A1B2C3D4E5
# The full path of Firebase's google-services.json of the Android app, without which it registers
# no phone for push. The release commands give the root .env's.
# GOOGLE_SERVICES_FILE=/Users/you/.config/myapp/android/google-services.json
