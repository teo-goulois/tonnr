# The API the app calls. On the iPhone simulator, the API on this Mac; on an Android emulator,
# 10.0.2.2 is the Mac. A phone needs an address it reaches, such as a tunnel's.
EXPO_PUBLIC_SERVER_URL=http://localhost:3000
# The web app's address, which the app's shared links name.
EXPO_PUBLIC_SITE_URL=http://localhost:3001
