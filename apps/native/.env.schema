# The app for phones' settings, read by Varlock as the app is bundled. Only what is public goes
# into an app: everything here is read by whoever holds the binary. Decision 069.
# @defaultRequired=true
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# The API the app calls, fixed when it is built: the store's builds call Téo's instance.
# @public @type=url
EXPO_PUBLIC_SERVER_URL=

# The web app's address, which the app's shared links name.
# @public @type=url
EXPO_PUBLIC_SITE_URL=

# The project of PostHog the app sends its analytics and its error reports to, through the web
# app's `/ingest` at `EXPO_PUBLIC_SITE_URL`, once the person said yes: the store's builds get the
# stage's `VITE_POSTHOG_PROJECT_TOKEN`. A project token is public in any app. Left out, the app
# sends nothing and asks nothing. Decisions 044, 054 and 069.
# @public @optional @type=string(minLength=1)
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=

# The environment the app's events say, as the web app's: `development` on this machine, `dev`
# for a pre-production, `production` for the stores. Left out, it is `development`.
# @public @optional @type=enum(development, dev, production)
EXPO_PUBLIC_POSTHOG_ENVIRONMENT=

# The address the app asks for updates of its JavaScript, written into the binary for good: the
# store's builds get it from their stage, as `https://` and the stage's `UPDATES_DOMAIN`. Left
# empty, as for a development build, the app asks for none. Decision 075.
# @public @optional @type=url
UPDATES_URL=

# The build number, the same on both platforms: the count of commits of `main` up to the one
# built, which the release commands give a store build. Left out, as for a development build, it
# is 1. Decision 075.
# @public @optional @type=number(min=1, isInt=true)
APP_BUILD_NUMBER=

# The Apple team that signs the app and its extensions, which the release commands give an iOS
# build from the stage's `APPLE_TEAM_ID`. Decision 075.
# @public @optional @type=string(matches=/^[A-Z0-9]{10}$/)
APPLE_TEAM_ID=

# The path of Firebase's `google-services.json` of the Android app, which it registers for push
# with, read as it is built and kept out of the repository: the release commands give the root
# `.env`'s. Left out, the Android app registers no phone. Decision 072.
# @public @optional @type=string
GOOGLE_SERVICES_FILE=
