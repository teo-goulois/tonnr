# The app for phones' settings, read by Varlock as the app is bundled. Only what is public goes
# into an app: everything here is read by whoever holds the binary. Decision 069.
# @defaultRequired=true
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# The API the app calls, fixed when it is built: the store's builds call Téo's instance.
# @public @type=url
EXPO_PUBLIC_SERVER_URL=

# The web app's address, which the app's shared links name.
# @public @type=url
EXPO_PUBLIC_SITE_URL=
