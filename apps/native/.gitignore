# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# The certificate the updates are checked with, which is public: its key stays out of the
# repository. Decision 075.
!/certs/certificate.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Paraglide's compiled messages, written from apps/web/messages by scripts/messages.mjs.
/src/paraglide/

!.env.schema
/src/env.ts
