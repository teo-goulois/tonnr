# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# Optional product analytics. All three are set together, or none. Decision 044.
# @public @optional @type=string(minLength=1)
VITE_POSTHOG_PROJECT_TOKEN=

# EU: https://eu.i.posthog.com; US: https://us.i.posthog.com
