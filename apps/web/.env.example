# Copy to .env and fill in. The schema in .env.schema describes each variable.

# The address of the API, as the browser reaches it.
VITE_SERVER_URL=http://localhost:3000

# Optional. Your own PostHog project, region and environment, all three together.
# VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_POSTHOG_ENVIRONMENT=development

# Optional audience counts by Umami, set together. Decision 055.
# VITE_UMAMI_SCRIPT_URL=https://umami.example.org/script.js
# VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# À classer

VITE_POSTHOG_ENVIRONMENT=
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
